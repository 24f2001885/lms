# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly ensure shell scripts use LF line endings across all platforms
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
