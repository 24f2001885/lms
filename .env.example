
#app setting 

FLASK_APP=app   #flask cli 
FLASK_ENV= development #mode dev,test,production
SECRET_KEY=randomint #code for cookies and session login and csrf 

#db connection 
DATABASE_URL=sqlite:///instance/lms.db
APP_TIMEZONE=Asia/Kolkata   #unifrom timezone 

#preseeded super admin 
ADMIN_EMAIL=abhishekpathak4312@gmail.com
ADMIN_FULL_NAME=Abhishek Pathak 
ADMIN_INITIAL_PASSWORD = Password321!

#session security 
SESSION_COOKIE_SECURE=false # Set true in production over HTTPS
PERMANENT_SESSION_LIFETIME_MINUTES=30  # Session inactivity timeout
USE_PROXY_FIX=false # Set true when behind Nginx reverse proxy
PREFERRED_URL_SCHEME=http # Set https in production 

#loggings : debug|info|warrning | error | critical
LOG_LEVEL=INFO
LOG_FILE=logs/lms.log

# Rate Limiting & Security (Milestone P11)
LOGIN_RATE_LIMIT_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_IP_FAILURES=20
SESSION_ABSOLUTE_LIFETIME_MINUTES=480
SECURITY_HEADERS_ENABLED=true
CSP_REPORT_ONLY=false

# Mail & Scorecard Settings (Milestone P12)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=emp@example.edu
MAIL_SUPPRESS_SEND=true
MAIL_ASYNC=true
MAIL_MAX_ATTEMPTS=3
EMAIL_LOG_RETENTION_DAYS=90
APP_BASE_URL=http://127.0.0.1:5002 # In production set https://lms.abhishek4312.info
